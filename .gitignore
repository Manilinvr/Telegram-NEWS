# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
build/
*.tsbuildinfo

# secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
!packages/backend/src/**/*.key.ts
secrets/
.secrets/

# runtime data
#
# Ведущий слэш обязателен: без него «storage/» совпадает с любой папкой
# с таким именем на любой глубине — и исходники
# packages/backend/src/modules/storage/ молча не попадают в коммит.
# Сборка при этом проходит локально и падает на чистом клоне.
/storage/
/media-local/
tmp/
*.log
logs/
backups/
coverage/
.nyc_output/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# test artifacts
test-results/
playwright-report/
