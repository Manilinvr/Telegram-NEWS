# =============================================================================
# Новороссийск — система мониторинга новостей
# Скопируйте этот файл в `.env` и заполните значения.
# ФАЙЛ `.env` НИКОГДА НЕ КОММИТИТСЯ В GIT (см. .gitignore).
# =============================================================================

# --- Окружение -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Человекочитаемые логи в dev; в production всегда JSON.
LOG_PRETTY=true

# --- HTTP ------------------------------------------------------------------
API_HOST=0.0.0.0
# Если платформа развёртывания (Render, Railway, Fly) сама назначает порт
# и передаёт его в PORT, задавать API_PORT не нужно: он будет взят оттуда.
API_PORT=4000
# Базовый публичный URL фронтенда (для CORS и ссылок). Без слэша в конце.
PUBLIC_WEB_ORIGIN=http://localhost:5173
# true — только за доверенным реверс-прокси (включает доверие X-Forwarded-*).
TRUST_PROXY=false
# Путь к собранному интерфейсу. Если сборка есть, тот же процесс отдаёт
# и API, и панель — один адрес, без CORS. Пусто = только API.
FRONTEND_DIST_PATH=packages/frontend/dist
# Запускать воркер внутри процесса API: удобно для личной установки,
# когда не хочется поднимать второй сервис.
RUN_WORKER_IN_API=false

# --- База данных -----------------------------------------------------------
DATABASE_URL=postgres://nnm:nnm@localhost:5432/nnm
DATABASE_POOL_MAX=10
# Включить SSL для подключения к БД (true в managed-окружениях, включая Supabase).
DATABASE_SSL=false
# Корневой сертификат для проверки подлинности сервера БД.
# Supabase предъявляет собственную цепочку, которой нет у Node: без
# сертификата подключение обрывается с SELF_SIGNED_CERT_IN_CHAIN.
# Скачать: Supabase → Settings → Database → SSL Configuration.
# Принимается путь к файлу или содержимое сертификата целиком.
DATABASE_SSL_CA=
# Запасной путь, если сертификат получить не удалось: соединение
# останется шифрованным, но подлинность сервера проверяться не будет.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Лимит времени запроса, мс. Поставьте 0, если используете пулер в режиме
# транзакций (Supabase, порт 6543) — он отклоняет этот параметр.
# Для этой системы рекомендуется session pooler, где лимит работает.
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Безопасность / сессии -------------------------------------------------
# ОБЯЗАТЕЛЬНО сгенерируйте собственные значения (минимум 32 байта):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
CSRF_SECRET=
# Время жизни сессии (в минутах) и «скользящее» продление.
SESSION_TTL_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=120
# Secure-флаг cookie. В production ОБЯЗАН быть true (требуется HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Домен cookie (пусто = текущий хост).
COOKIE_DOMAIN=

# Защита от перебора пароля.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Общий лимит запросов к API (в минуту, на IP).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MINUTES=1
# Отдельный, жёсткий лимит для /api/auth/login.
AUTH_RATE_LIMIT_MAX=10

# --- Первоначальный администратор ------------------------------------------
# Пароль задаётся ТОЛЬКО через переменную окружения при первом запуске
# `npm run bootstrap:admin`, никогда не хранится в коде или в БД в открытом виде.
BOOTSTRAP_ADMIN_EMAIL=efimenkodaniil151@gmail.ru
# Оставьте пустым — скрипт сгенерирует пароль и покажет его ОДИН раз в консоли.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Хранилище медиа -------------------------------------------------------
# Драйвер: `local` (файловая система) или `s3` (MinIO / S3-совместимое).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/media
# Ограничения загрузки.
MEDIA_MAX_FILE_MB=200
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime,video/webm,audio/mpeg,audio/ogg,audio/mp4

# S3 / MinIO (используется при STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nnm-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true для MinIO (path-style адресация).
S3_FORCE_PATH_STYLE=true

# --- Очередь и воркеры -----------------------------------------------------
# Очередь реализована на PostgreSQL (FOR UPDATE SKIP LOCKED) — Redis не нужен.
# Воркер запускается отдельным процессом (npm run dev:worker) либо внутри
# API — см. RUN_WORKER_IN_API выше.
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=750
WORKER_MAX_ATTEMPTS=5
# Интервал опроса источников по умолчанию (секунды); настраивается на источник.
SOURCE_POLL_INTERVAL_SECONDS=60

# --- Telegram: чтение источников -------------------------------------------
# Режим доступа к публичным Telegram-каналам:
#   `bot`    — официальный Bot API. Бот должен быть добавлен в канал.
#              Это единственный режим, не требующий пользовательского аккаунта.
#   `mtproto`— пользовательский клиент (требует TELEGRAM_API_ID/HASH и логин).
#   `none`   — Telegram-источники отключены.
# См. docs/SETUP-SOURCES.md.
TELEGRAM_INGEST_MODE=bot
TELEGRAM_BOT_TOKEN=
# Только для mtproto-режима:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# --- Telegram: публикация --------------------------------------------------
# Бот-публикатор должен быть администратором целевого канала.
TELEGRAM_PUBLISH_BOT_TOKEN=
# @username или числовой ID канала, например: @my_channel или -1001234567890
TELEGRAM_PUBLISH_CHANNEL=
# Не отправлять реальные запросы (сухой прогон) — удобно для приёмки.
TELEGRAM_PUBLISH_DRY_RUN=true

# --- VK --------------------------------------------------------------------
# Сервисный ключ доступа приложения VK (public data only).
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199

# --- AI --------------------------------------------------------------------
# Провайдер: `anthropic` | `mock`. `mock` — детерминированная заглушка,
# позволяет запускать весь pipeline и тесты без внешних ключей.
# Откуда берётся разбор новостей:
#   mock              — по правилам, без модели. Текст источника очищается
#                       от ссылок и зазывов, но НЕ переписывается;
#   anthropic         — модель Anthropic (платно);
#   openai-compatible — любая служба с интерфейсом OpenAI, в том числе с
#                       бесплатным тарифом, и локальные модели.
AI_PROVIDER=mock

# Для openai-compatible: адрес службы до /chat/completions.
# Примеры: https://generativelanguage.googleapis.com/v1beta/openai
#                                     (Google AI Studio, бесплатный тариф)
#          https://api.deepseek.com/v1  (DeepSeek, дёшево)
#          https://api.groq.com/openai/v1
#          https://openrouter.ai/api/v1
#          http://localhost:11434/v1   (локальная модель)
AI_BASE_URL=
# Ключ этой службы. Локальной модели ключ обычно не нужен.
AI_API_KEY=
ANTHROPIC_API_KEY=
# Название модели в ВЫБРАННОЙ службе. Значение ниже понимает только
# Anthropic; для DeepSeek это deepseek-chat, для Groq —
# llama-3.3-70b-versatile. Чужое название служба отклоняет, и разбор
# молча уходит на правила, поэтому при openai-compatible его требуется
# указать явно — иначе запуск остановится с объяснением.
AI_MODEL=claude-opus-5

# Готовый набор для бесплатного Gemini — название модели возьмите в
# aistudio.google.com, линейка обновляется:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=...
# AI_MODEL=...

# Готовый набор для DeepSeek — раскомментируйте вместо трёх строк выше:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=deepseek-chat
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=60000
AI_TEMPERATURE=0.2

# --- Embeddings (дедупликация) ---------------------------------------------
# Провайдер: `local` (детерминированный, без сети) | `voyage`.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=512
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Транскрипция видео ----------------------------------------------------
# Провайдер: `none` | `whisper-cpp` | `openai-compatible` | `mock`
TRANSCRIPTION_PROVIDER=none
# Для `whisper-cpp`: путь к бинарнику и модели.
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
# Для `openai-compatible` (self-hosted faster-whisper, и т. п.):
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=ru
# Путь к ffmpeg/ffprobe (пусто = искать в PATH).
FFMPEG_PATH=
FFPROBE_PATH=
# Максимальная длительность видео для транскрипции (секунды).
TRANSCRIPTION_MAX_DURATION_SECONDS=900

# --- Дедупликация ----------------------------------------------------------
# Окно поиска кандидатов (часы) и пороги объединения.
DEDUP_TIME_WINDOW_HOURS=36
DEDUP_MERGE_THRESHOLD=0.78
DEDUP_REVIEW_THRESHOLD=0.62

# --- Модерация / публикация ------------------------------------------------
# Автопубликация переменной окружения НЕ управляется: переключатель живёт
# в интерфейсе (Настройки → Публикация) и требует подтверждения паролем.
# По умолчанию выключена — каждый материал подтверждает человек.

# --- Резервное копирование -------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
